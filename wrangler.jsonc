{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "el-granero",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    // La app de React es una SPA: cualquier ruta que no sea un archivo devuelve index.html.
    "not_found_handling": "single-page-application",
    // La API siempre la atiende el Worker, nunca el fallback de la SPA.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "el-granero",
      // Reemplazar por el id real que devuelve `wrangler d1 create el-granero` antes del primer deploy.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  "triggers": {
    // 00:05 en America/Argentina/Buenos_Aires (UTC-3, sin horario de verano) = 03:05 UTC.
    // Si la zona horaria de la Familia es otra, ajustar este horario.
    "crons": ["5 3 * * *"]
  },
  "observability": { "enabled": true }
}
